# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://securestay:securestay@db:5432/securestay

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me_with_64_hex_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_64_hex_chars

# Generate with: openssl rand -hex 32  (32 bytes -> AES-256 key)
FIELD_ENCRYPTION_KEY=replace_me_with_32_byte_hex_key

# Stripe test mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:3000
